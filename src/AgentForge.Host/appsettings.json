{
  "AgentForge": {
    "Host": {
      "Urls": "http://127.0.0.1:5047",
      "RemoteEnabled": false,
      "AllowedOrigins": [],
      "RequestsPerMinute": 120,
      "MaximumRequestBodyBytes": 262144
    },
    "Installation": {
      "StateFileName": "installation-state.json"
    },
    "Persistence": {
      "Provider": "Sqlite",
      "DatabaseFileName": "agentforge.db",
      "ArtifactDirectoryName": "artifacts",
      "EnableConnectionPooling": true,
      "PostgreSqlConnectionStringEnvironmentVariable": "AGENTFORGE_POSTGRESQL_CONNECTION",
      "PostgreSqlDumpExecutable": "",
      "PostgreSqlRestoreExecutable": ""
    },
    "Security": {
      "MaximumRedactionPayloadBytes": 1048576,
      "MaximumRedactionDepth": 32,
      "MaximumSecretCharacters": 16384,
      "SecretDirectoryName": "secrets"
    },
    "Mcp": {
      "AllowedTools": [ "agentforge_status" ],
      "AllowedResources": [ "agentforge://status" ],
      "MaximumResultCharacters": 16384
    },
    "Plugins": {
      "Directory": "data/plugins",
      "MaximumPackages": 128,
      "MaximumManifestBytes": 65536,
      "MaximumAssemblyBytes": 134217728,
      "PluginWorkerExecutable": "",
      "TrustedPublicKeys": {}
    },
    "DockerSandbox": {
      "RuntimeExecutable": "",
      "ImageReference": "",
      "ContainerUser": "65532:65532",
      "MemoryMegabytes": 512,
      "CpuLimit": 1.0,
      "ProcessLimit": 128,
      "TemporaryMegabytes": 64,
      "CleanupTimeoutSeconds": 30
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
